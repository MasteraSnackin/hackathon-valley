# No secrets. Local defaults are deliberately restricted to loopback.
APP_MODE=demo
WORKFLOW_MODE=native_local
WORKFLOW_TARGET_WORLD=local
AI_MODE=literal_demo
# Compatibility alias if AI_MODE is absent: MODEL_MODE=literal_demo
# Optional; defaults to ./var/property.db for this local demo only.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/property_workflow
# Live model integration requires explicit AI_MODE=live (or alias MODEL_MODE=live_model) and credentials.
# It is unverified. The default literal_demo never calls a model, even if a key exists.
# AI_MODE=live
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# For a separately provisioned deployment:
# APP_MODE=production
# WORKFLOW_MODE=native_cloud
# WORKFLOW_TARGET_WORLD=vercel
# STAFF_TOKEN_ROLES=[{"id":"staff-id","role":"case_manager","sha256":"SHA256_OF_A_RANDOM_SECRET"}]
# Vercel native workflow credentials/configuration come from Vercel's runtime.

WORKFLOW_LOCAL_DATA_DIR=var/native-world
